{
  "name": "moholocal",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "process-signals": "cd scripts && npm install --silent && node process-signals.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "15.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@opennextjs/cloudflare": "1.20.16",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.0",
    "tsx": "4.23.15",
    "typescript": "^5.0.0",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "glob": "14.0.3",
    "minimatch": "11.0.1"
  }
