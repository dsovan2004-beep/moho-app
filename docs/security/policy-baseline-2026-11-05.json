  "jsonb_build_object": {
    "views": [
      {
        "viewname": "pending_review",
        "definition": " SELECT 'business'::text AS record_type,\n    (businesses.id)::text AS id,\n    businesses.name AS title,\n    businesses.city,\n    businesses.source,\n    businesses.confidence_score,\n    businesses.created_at\n   FROM businesses\n  WHERE ((businesses.needs_review = true) AND (businesses.status = 'pending'::text))\nUNION ALL\n SELECT 'event'::text AS record_type,\n    (events.id)::text AS id,\n    events.title,\n    events.city,\n    events.source,\n    events.confidence_score,\n    events.created_at\n   FROM events\n  WHERE ((events.needs_review = true) AND (events.ingestion_status = 'pending'::text))\nUNION ALL\n SELECT 'lost_found'::text AS record_type,\n    (lost_and_found.id)::text AS id,\n    lost_and_found.title,\n    lost_and_found.city,\n    lost_and_found.source,\n    lost_and_found.confidence_score,\n    lost_and_found.created_at\n   FROM lost_and_found\n  WHERE ((lost_and_found.needs_review = true) AND (lost_and_found.ingestion_status = 'active'::text))\n  ORDER BY 7 DESC;"
      }
    ],
